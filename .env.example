# ── VoxFlow Agent Environment Configuration ──────────────────────────

# LLM Provider Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Voice Configuration
WAKE_WORD=hey voxflow
RECORD_SECONDS=10
SILENCE_DURATION=1.2
MIN_VOICE_RMS=350

# Text-to-Speech Configuration (Optional)
# macOS voice examples: Samantha, Alex, Victoria
# Windows SAPI rate: -10 to 10 (0 is normal)
TTS_VOICE=Samantha
TTS_RATE=180

# Web Dashboard Configuration
DASHBOARD_PORT=8765

# Security / Command Execution
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_COMMANDS=true
COMMAND_TIMEOUT_SECONDS=30
